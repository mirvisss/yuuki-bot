# Yuuki — шаблон окружения. Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# .env не попадает в репозиторий. Если эти же переменные заданы в окружении
# (Docker, systemd, pm2), значения из файла их не перетирают.

# ── Discord Developer Portal → Application → Bot ─────────────────────────────
BOT_TOKEN=
CLIENT_ID=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ── Groq (AI-чат, TTS) — https://console.groq.com/keys ──────────────────────
GROQ_API_KEY=
# Необязательные резервные ключи: aiUtils перебирает их при лимитах/сбоях
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# ── SerpAPI (поиск в интернете) — https://serpapi.com/manage-api-key ─────────
SERPAPI_API_KEY=

# ── Сторонние API изображений/GIF ────────────────────────────────────────────
BYTEZ_API_KEY=
TENOR_API_KEY=

# ── Язык бота (переводы в src/locales) ───────────────────────────────────────
# ru — русский (по умолчанию), en — английский (строки остаются в коде)
BOT_LOCALE=ru
